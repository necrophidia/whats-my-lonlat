{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noConsole": "warn",
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": false
          }
        },
        "noVar": "error",
        "noRedundantUseStrict": "off"
      },
      "style": {
        "useConst": "warn"
      }
    }
  },
  "javascript": {
    "globals": [
      "L"
    ]
  }
}
